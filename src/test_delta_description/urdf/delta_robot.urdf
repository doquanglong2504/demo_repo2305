<?xml version="1.0" encoding="utf-8"?>
<robot name="delta_robot">
  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Arm 1 -->
  <link name="upper_arm_link_1">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.02"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="upper_arm_joint_1" type="revolute">
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="upper_arm_link_1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <link name="lower_arm_link_1">
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.4" radius="0.015"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.4" radius="0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="lower_arm_joint_1" type="revolute">
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <parent link="upper_arm_link_1"/>
    <child link="lower_arm_link_1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Platform Link -->
  <link name="platform_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.01"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Sửa khớp ball thành fixed -->
  <joint name="platform_joint_1" type="fixed">
    <parent link="lower_arm_link_1"/>
    <child link="platform_link"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
  </joint>

  <!-- End Effector -->
  <link name="end_effector">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="end_effector_joint" type="fixed">
    <parent link="platform_link"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>
</robot>
